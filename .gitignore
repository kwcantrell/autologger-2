node_modules/
.env
.env.*
!*.example
dist/
.next/
*.log
.DS_Store

# local server data (SQLite DBs + audio blobs), see DATA_DIR in .env.example
data/

# editor swap files
*.swp

# editor workspace config (local preference, not repo policy)
.vscode/

# opsx:apply scratch (per-task subagent reports, diff files, progress ledger)
openspec/changes/**/.apply/

# Cursor MCP config — machine-local (absolute checkout path); see .cursor/mcp.json.example
.cursor/mcp.json

# graphify knowledge-graph output (regenerable via /graphify)
graphify-out/

# Playwright MCP session captures (page snapshots dumped during interactive use)
.playwright-mcp/

# TypeScript incremental build info (composite tsconfig.node.json projects)
*.tsbuildinfo

# Pre-template lifecycle files, kept locally for reference
old-lifecycle/

# shadcn-migration QA screenshots (local review only; probes + contrast JSON are tracked)
openspec/changes/**/qa/**/*.png
