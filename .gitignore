node_modules/
.env
dist/
*.log
.DS_Store

# local server data (SQLite DBs + audio blobs), see DATA_DIR in .env.example
data/

# editor swap files
*.swp

# opsx:apply scratch (per-task subagent reports, diff files, progress ledger)
openspec/changes/*/.apply/

# graphify knowledge-graph output (regenerable via /graphify)
graphify-out/

# e2e server state — wiped by playwright.config.ts's webServer.command each run
e2e/.data/
e2e/.data-oauth/

# Playwright's default artifact/report output
test-results/
playwright-report/

# Playwright MCP session captures (page snapshots dumped during interactive use)
.playwright-mcp/
