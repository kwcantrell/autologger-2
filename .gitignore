node_modules/
.env
dist/
.next/
*.log
.DS_Store

# local server data (SQLite DBs + audio blobs), see DATA_DIR in .env.example
data/

# editor swap files
*.swp

# editor workspace config (local preference, not repo policy)
.vscode/

# opsx:apply scratch (per-task subagent reports, diff files, progress ledger)
openspec/changes/**/.apply/

# Cursor MCP config — machine-local (absolute checkout path); see .cursor/mcp.json.example
.cursor/mcp.json

# graphify knowledge-graph output (regenerable via /graphify)
graphify-out/

# web-docs generated extraction artifact (regenerated by every build/dev start)
web-docs/atlas.json

# e2e server state — wiped by playwright.config.ts's webServer.command each run
e2e/.data/
e2e/.data-oauth/

# Playwright's default artifact/report output
test-results/
playwright-report/

# Playwright MCP session captures (page snapshots dumped during interactive use)
.playwright-mcp/

# web-docs extractImports fixture: a real `node_modules/` symlink tree is the
# only way to reproduce TypeScript's node_modules-mediated module resolution
# (npm workspace hoisting) inside a test fixture — un-ignore it specifically
# rather than the pattern above.
!web-docs/src/lib/__fixtures__/extract-imports/workspace-pkg/node_modules/
!web-docs/src/lib/__fixtures__/extract-imports/workspace-pkg/node_modules/**

# TypeScript incremental build info (composite tsconfig.node.json projects)
*.tsbuildinfo
