{
  // AutoLogger on Cloudflare — phase 1-2 subset.
  // Local-dev only: D1/KV ids are placeholders Miniflare ignores in `wrangler dev`/`--local`.
  // Real ids + `wrangler deploy` are a later, login-gated step the user runs themselves.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autologger",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autologger",
      "database_id": "local",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "AUTH", "id": "local" }],
  "durable_objects": {
    "bindings": [{ "name": "SESSION_DO", "class_name": "SessionDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "autologger-audio" }],
  // SPA is built into ./public by the frontend's CF build (AUTOLOGGER_CF_BUILD=1).
  // "none": `/` and `/admin/users` are independent page builds with no client-side
  // router, so the Worker routes HTML explicitly and ASSETS streams hashed statics.
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none" },
  "vars": {
    "PUBLIC_BASE_URL": "http://127.0.0.1:8787",
    "GOOGLE_CLIENT_ID": "",
    "REQUIRE_LOGIN": "0",
    "SESSION_COOKIE": "autologger_sid",
    "SESSION_DAYS": "14",
    "NEW_USER_ALL_TEAMS": "0",
    "COOKIE_SECURE": "",
    "IP_ALLOWLIST": ""
  }
}
