# Compose environment for the AutoLogger split deployment (copy to ./.env; gitignored).
# No real values belong in this tracked file.
#
# WARNING: these are PRODUCTION secrets; never reuse them in dev/stage env files (.env.dev, .env.stage).

# Image tags: explicit, git-SHA-derived (docker buildx bake tags GIT_SHA). Never "latest".
WEB_TAG=
API_TAG=
# e.g. WEB_TAG=6ca18cd906f8 and API_TAG=6ca18cd906f8 (12-char SHA from make prod-push)

# Host loopback port the router publishes (Newt/Pangolin targets 127.0.0.1:<port>).
ROUTER_PORT=8080

# Public HTTPS origin (the OAuth redirect is ${PUBLIC_BASE_URL}/auth/google/callback).
PUBLIC_BASE_URL=

# Google OAuth client. REQUIRED: the server refuses to boot when either is blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The bootstrap owner's email (owner-bootstrap). REQUIRED: compose-run and the server refuse to
# start when it is blank. A verified sign-in with this email owns every team that has no owner.
BOOTSTRAP_OWNER_EMAIL=
# Optional (run-status-and-sweeper D9): approved users for the run features (AI chat, AI v2 design,
# topic and event generation, YouTube import, transcript generation), comma-separated. The
# bootstrap owner is always approved; others get 403. To grant someone, add their email and restart.
RUN_FEATURE_EMAILS=
# Optional (ai-sdk-agent-harness): the accounts that may choose "Claude CLI (operator)" in
# Settings -> Advanced, comma-separated (trimmed, ASCII case-insensitive). The bootstrap owner is
# NOT implicitly listed; empty means nobody. Set it in OpenBao; never commit real addresses.
CLAUDE_CLI_EMAILS=
# REQUIRED (byo-ai-providers): base64 of 32 bytes (`openssl rand -base64 32`) that encrypts users'
# provider keys. compose-run and the server refuse to start without it; never change it once keys
# are stored (see docs/openbao-secrets.md).
PROVIDER_KEYS_SECRET=

# Machine token: ADMIN_TOKEN authenticates only /api/admin/*. API_TOKEN is ignored since ADR 0021
# slice 9d: a Companion uses a per-device token created in Settings -> Companion devices.
ADMIN_TOKEN=

# Optional operator values (uncomment to use). server/.env.example is the reference for what
# each means, but do NOT copy it wholesale: this file is for secrets and operator choices only.
# DEEPGRAM_API_KEY= is not used in production (byo-ai-providers): each user adds their own
# speech-to-text key in Settings -> Advanced.
# AI_V2_API_KEY=
# AI SDK turn limits (ai-sdk-agent-harness; the caller's own key pays). Defaults: chat 8 steps
# (1-50) and 400000 tokens per turn; topic and event generation 40 steps (1-100), 3000000 tokens
# and 16000 output tokens per step (1000-128000). Out of range falls back to the default.
# AI_CHAT_MAX_STEPS=
# AI_CHAT_MAX_TOKENS=
# GENERATE_MAX_STEPS=
# GENERATE_MAX_TOKENS=
# GENERATE_MAX_OUTPUT_TOKENS=
# IP_ALLOWLIST=
# NOTE: PUBLIC_BASE_URL must be set here, because compose interpolates it (e.g. the OAuth
# redirect). The other pinned keys (TRUST_PROXY, COOKIE_SECURE) and container
# paths (NODE_ENV, DATA_DIR, HOST, PORT, YTDLP_PATH, CLAUDE_CLI_PATH) are set in compose.yaml
# and have no effect here.
