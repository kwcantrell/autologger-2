# Compose environment for the AutoLogger split deployment (copy to ./.env; gitignored).
# No real values belong in this tracked file.

# Image tags: explicit, git-SHA-derived (docker buildx bake tags GIT_SHA). Never "latest".
WEB_TAG=
API_TAG=

# Host loopback port the router publishes (Newt/Pangolin targets 127.0.0.1:<port>).
ROUTER_PORT=8080

# Public HTTPS origin (the OAuth redirect is ${PUBLIC_BASE_URL}/auth/google/callback).
PUBLIC_BASE_URL=

# Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Machine tokens: API_TOKEN authenticates only /api/companion/*; ADMIN_TOKEN only /api/admin/*.
API_TOKEN=
ADMIN_TOKEN=

# Optional, see server/.env.example for the full list and cost warnings.
# DEEPGRAM_API_KEY=
# AI_V2_API_KEY=
# NOTE: REQUIRE_LOGIN, TRUST_PROXY, COOKIE_SECURE and PUBLIC_BASE_URL are fixed by compose.yaml.
