# Per-host OpenBao credentials for ONE environment (openbao-secrets design D1).
#   cp docker/openbao-credentials.example .env.openbao.dev     # or .stage / .prod
#   chmod 600 .env.openbao.dev                                  # compose-run.mjs refuses anything looser
# The copy is git-ignored and must be owned by you, a regular file (no symlink). On the VMs,
# Ansible (~/spark-infra, role autologger_env) renders it. One AppRole per environment, with its
# secret_id bound to this host's address: never put prod credentials on a dev host. Never reuse
# prod secrets in dev or stage. See docs/openbao-secrets.md.
#
# A bare https origin, no path. VMs use https://10.88.0.10:8200; the Spark host and other LAN
# hosts use https://192.168.0.100:8200.
BAO_ADDR=
# Absolute path of the CA certificate OpenBao's TLS chains to (Node does not use the system
# store), e.g. /usr/local/share/ca-certificates/spark-root-ca.crt. Regular file, not
# group/other-writable, at most 64 KiB.
BAO_CACERT=
# The environment's AppRole (autologger-dev, autologger-stage, ...).
BAO_ROLE_ID=
BAO_SECRET_ID=
# KV v2 path of this environment's secret: MOUNT/PATH, ending in the environment name.
# e.g. kv/autologger/dev
BAO_KV_PATH=
