# Per-host Infisical credentials for ONE environment (infisical-secrets design D1).
#   cp docker/infisical-credentials.example .env.infisical.dev     # or .stage / .prod
#   chmod 600 .env.infisical.dev                                    # compose-run.mjs refuses anything looser
# The copy is git-ignored and must be owned by you, a regular file (no symlink). One machine
# identity per environment: never put prod credentials on a dev host. Never reuse prod secrets in
# dev or stage. See docs/infisical-secrets.md.
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
# A bare https origin, e.g. https://192.168.0.100 (no path).
INFISICAL_DOMAIN=
# Absolute path of the CA certificate Infisical's TLS chains to (Node does not use the system
# store), e.g. /home/<you>/infisical/infisical-root-ca.crt. Regular file, not group/other-writable.
INFISICAL_CA_FILE=
