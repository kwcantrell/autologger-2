{
	"admin": {
		"listen": "127.0.0.1:2019",
		"config": {
			"persist": false
		}
	},
	"apps": {
		"http": {
			"servers": {
				"srv0": {
					"listen": [
						":8080"
					],
					"routes": [
						{
							"handle": [
								{
									"handler": "subroute",
									"routes": [
										{
											"handle": [
												{
													"handler": "headers",
													"response": {
														"require": {
															"headers": {
																"Content-Security-Policy": null
															}
														},
														"set": {
															"Content-Security-Policy": [
																"frame-src https://dashboards.example.invalid/runtime/v1/frame.html"
															]
														}
													}
												}
											],
											"match": [
												{
													"not": [
														{
															"host": [
																"dashboards.example.invalid"
															]
														}
													]
												}
											]
										},
										{
											"handle": [
												{
													"handler": "headers",
													"response": {
														"deferred": true,
														"delete": [
															"Server",
															"Via"
														]
													}
												}
											]
										},
										{
											"group": "group8",
											"handle": [
												{
													"handler": "subroute",
													"routes": [
														{
															"group": "group0",
															"handle": [
																{
																	"handler": "rewrite",
																	"uri": "/__autologger_rejected"
																}
															]
														},
														{
															"handle": [
																{
																	"handler": "reverse_proxy",
																	"headers": {
																		"request": {
																			"set": {
																				"X-Forwarded-For": [
																					"{http.vars.client_ip}"
																				]
																			}
																		}
																	},
																	"transport": {
																		"compression": false,
																		"protocol": "http"
																	},
																	"upstreams": [
																		{
																			"dial": "api:8787"
																		}
																	]
																}
															]
														}
													]
												}
											],
											"match": [
												{
													"expression": {
														"expr": "{http.request.uri}.matches(\"(?i)^[^?]*/(\\\\.|%2e){1,2}(/|\\\\?|$)\") || {http.request.uri}.matches(\"^[^?]*//\") || ({http.request.uri}.matches(\"^/(a|%61)(p|%70)(i|%69)(/|\\\\?|$)|^/(a|%61)(u|%75)(t|%74)(h|%68)(/|\\\\?|$)\") \u0026\u0026 {http.request.uri}.matches(\"^[^?]*(%2[fF]|%5[cC])\"))",
														"name": "traversal"
													}
												}
											]
										},
										{
											"group": "group8",
											"handle": [
												{
													"handler": "subroute",
													"routes": [
														{
															"handle": [
																{
																	"abort": true,
																	"handler": "static_response"
																}
															]
														}
													]
												}
											],
											"match": [
												{
													"expression": {
														"expr": "{http.request.header.Upgrade} != \"\" \u0026\u0026 {http.request.header.Connection}.matches(\"(?i)(^|,)[ \\\\t]*upgrade[ \\\\t]*(,|$)\") \u0026\u0026 !{http.request.uri}.matches(\"^/api(/|\\\\?|$)\")",
														"name": "upgradeOutsideApi"
													}
												}
											]
										},
