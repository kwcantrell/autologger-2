# Compose environment for the AutoLogger DEV container (copy to ./.env.dev; gitignored).
#   cp docker/.env.dev.example .env.dev      (from the repo root)
# No real values belong in this tracked file. The owner fills in the values.
#
# WARNING: never reuse production secrets here. Use separate, low-limit keys for dev.

# ---- Published ports (both bound to 127.0.0.1 on the host) ----
# Dev app gate (Host/Origin gate in front of the hot-reload app). Default 8787.
# Collides with a host `npm run dev` on :8787: run one or the other, or change this.
DEV_PORT=
# Dev Companion admin UI gate. Default 8000.
DEV_COMPANION_PORT=

# ---- Optional integrations (leave empty to disable) ----
# Transcript generation: sends recorded audio to DeepGram (spend + audio egress).
DEEPGRAM_API_KEY=
# Sheets log import (1 to enable).
SHEETS_LOG_IMPORT_ENABLED=
# AI v2 design (1 to enable). In dev it runs on the mounted Claude login (see below), so
# AI_V2_API_KEY is optional.
AI_V2_ENABLED=
AI_V2_API_KEY=

# ---- Google sign-in (REQUIRED) ----
# Login is always required. compose-run and the server both refuse to start dev unless
# both are set. Sign in at http://localhost:<DEV_PORT>/; the OAuth client needs the
# authorized redirect URI
#   http://localhost:8787/auth/google/callback      (use your DEV_PORT if changed)
# Use a dev-only OAuth client, never production's.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Companion bearer token (>= 32 random bytes); set the same value in the dev Companion
# connection. Without it the dev Companion gets 401.
API_TOKEN=

# ---- Notes ----
# Claude login: comes ONLY from the host ~/.claude/.credentials.json, the single host file
# dev mounts (read-write). There is no login step inside the container. Nothing else under
# the host ~/.claude or ~/.claude.json is mounted.
#
# Pinned in docker/compose.dev.yaml as literals, so setting any of these here has NO effect:
#   HOST, TRUST_PROXY, IP_ALLOWLIST, DATA_DIR, PORT, PUBLIC_BASE_URL
# (PUBLIC_BASE_URL is http://localhost:${DEV_PORT}.) Container paths such as
# CLAUDE_CLI_PATH and YTDLP_PATH are also set by compose.
#
# A dependency-manifest, lockfile, or config change needs `make dev-build`.
