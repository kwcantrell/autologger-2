# Compose environment for the AutoLogger STAGE stack (copy to ./.env.stage; gitignored).
#   cp docker/.env.stage.example .env.stage      (from the repo root)
# No real values belong in this tracked file. The owner fills in the values.
#
# WARNING: never reuse production secrets here (OAuth client, tokens, API keys). Use a
# separate dev OAuth client and separate, low-limit keys.

# Host loopback port the stage router publishes. Default 8788.
STAGE_PORT=8788

# Dev Google OAuth client for stage (NOT production's). Authorized redirect URI:
#   http://localhost:8788/auth/google/callback      (use your STAGE_PORT if changed)
# Open stage at http://localhost:<STAGE_PORT>/ -- use `localhost`, NOT 127.0.0.1, or the
# OAuth redirect will not match.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Machine tokens. These MUST differ from production's. API_TOKEN authenticates only
# /api/companion/*; ADMIN_TOKEN only /api/admin/*. Generate >= 32 random bytes each, e.g.
#   openssl rand -hex 32
API_TOKEN=
ADMIN_TOKEN=

# Optional (use separate, low-limit keys).
# AI v2 in stage REQUIRES AI_V2_API_KEY (as in production); stage never mounts the host
# Claude login.
AI_V2_API_KEY=
DEEPGRAM_API_KEY=

# Notes:
# - Claude login for stage AI chat is stored in the stage api home volume: run
#   `make stage-claude-login`.
# - PUBLIC_BASE_URL, COOKIE_SECURE, SESSION_COOKIE, REQUIRE_LOGIN and TRUST_PROXY are set by
#   compose.yaml / docker/compose.stage.yaml and have no effect here.
