# Supabase gateway (supabase-services D3; spec "Supabase gateway routes and key checks").
# Upstream's legacy-key gateway semantics for auth, rest, realtime and storage, behind a Host and
# Origin check. Everything sits in ONE `route` block: outside it Caddy sorts handle_path before
# respond and every check would be skipped. Paths are matched with `path` (case-insensitive,
# slash- and percent-normalised); CEL compares key values only, never paths.
# Environment: SUPABASE_PORT, ANON_KEY, SERVICE_ROLE_KEY (compose; never logged).
{
	admin 127.0.0.1:2019
	auto_https off
	# Upstream-error logs print request headers, including apikey: keep them out (A14).
	log default {
		exclude http.log.error http.handlers.reverse_proxy
	}
}

:8000 {
	route {
		@badhost not header_regexp Host ^(localhost|127\.0\.0\.1):{$SUPABASE_PORT}$
		respond @badhost 403

		@badorigin {
			header Origin *
			not header_regexp Origin ^http://(localhost|127\.0\.0\.1):{$SUPABASE_PORT}$
		}
		respond @badorigin 403

		@blocked path /realtime/v1/api/tenants /realtime/v1/api/tenants/* /realtime/v1/api/openapi /realtime/v1/api/openapi/*
		respond @blocked 403

		# The realtime websocket may carry the key as ?apikey= (supabase-js does).
		@rtquery {
			path /realtime/v1/*
			not path /realtime/v1/api/*
			not header apikey *
		}
		request_header @rtquery apikey {query.apikey}

		@nokey {
			path /auth/v1/* /rest/v1 /rest/v1/* /realtime/v1/*
			not path /auth/v1/verify /auth/v1/verify/* /auth/v1/callback /auth/v1/callback/* /auth/v1/authorize /auth/v1/authorize/*
			not expression `{http.request.header.apikey} != "" && ({http.request.header.apikey} == "{$ANON_KEY}" || {http.request.header.apikey} == "{$SERVICE_ROLE_KEY}")`
		}
		respond @nokey 401

		@restroot {
			path /rest/v1 /rest/v1/
			not expression `{http.request.header.apikey} != "" && {http.request.header.apikey} == "{$SERVICE_ROLE_KEY}"`
		}
		respond @restroot 403

		# Bearer <apikey> when the client sent no (or an empty) Authorization; never replace a token.
		@bearer {
			not path /realtime/v1/websocket /realtime/v1/websocket/*
			expression `{http.request.header.Authorization} == "" && {http.request.header.apikey} != ""`
		}
		request_header @bearer Authorization "Bearer {http.request.header.apikey}"

		handle_path /auth/v1/* {
			reverse_proxy auth:9999
		}
		handle_path /rest/v1/* {
			reverse_proxy rest:3000
		}
		handle_path /realtime/v1/api/* {
			rewrite * /api{uri}
			reverse_proxy realtime:4000 {
				header_up Host realtime-dev.supabase-realtime
			}
		}
		handle_path /realtime/v1/* {
			rewrite * /socket{uri}
			reverse_proxy realtime:4000 {
				header_up Host realtime-dev.supabase-realtime
			}
		}
		handle_path /storage/v1/* {
			reverse_proxy storage:5000 {
				header_up -X-Forwarded-Path
				header_up X-Forwarded-Prefix /storage/v1
			}
		}
		respond 404
	}
}
