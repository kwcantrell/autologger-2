# AutoLogger internal router (containerize-split-images, design D2 / D7; spec
# "Internal router preserves the single-origin disposition matrix").
#
# Image: caddy@sha256:0c994536bddb66445885237f1a5dcc1916bccea922661c76b4e9fc24061f9b52
# (caddy:2, v2.11.4) -- pinned in compose.yaml, not here.
#
# This router writes NO response of its own (except `abort`, which writes nothing). Every 404
# the single-process server pins is still produced by the server. Invariants a future reader
# must not "helpfully" undo:
#   * NO `encode` directive anywhere: /api compression is server-owned (api-contract-freeze).
#   * NO Caddy `path` / `path_regexp` matcher, and no {http.request.uri.path} /
#     {http.request.orig_uri.path}: those are percent-DECODED (and `path` is case-INSENSITIVE),
#     so /sessions/a%2F, /API/x and %2e%2e traversal would flip layers. Every rule below matches
#     {http.request.uri} (raw, escaped, case-preserved, includes ?query) with CEL .matches()
#     (RE2, case-sensitive). `reverse_proxy` forwards the request-target byte for byte.
#   * Every reverse_proxy sets `transport http { compression off }`. Caddy's default upstream
#     transport (Go net/http) silently adds `Accept-Encoding: gzip` to requests that had none and
#     transparently DEcompresses the answer, which turns an identity `Content-Length` response
#     into a chunked one and makes the api compress work nobody asked for. With compression off
#     the request's Accept-Encoding and the upstream's Content-Encoding/Content-Length/Vary pass
#     through exactly as emitted (found by the container e2e encoding-parity test, task 5.4).
#   * Site-level `header { -Server -Via }`: reverse_proxy adds `Via`, and header_down cannot
#     remove it; the router must add no headers.
#
# Each rule mirrors ITS OWN server check (locate by content, not line number):
#   - HTTP routing: Hono `getPath` (node_modules/hono/dist/utils/url.js) applies a
#     %25-protected decodeURI to the raw path: /%61pi/x IS /api/x, %2F/%5C/%3F stay encoded,
#     letter case and `//` are preserved. server/src/app.ts bridge catch-all: `path !== '/' &&
#     path.endsWith('/')` -> notFound; `path === '/api' | '/auth' | startsWith('/api/' | '/auth/')`
#     -> notFound. Node's WHATWG URL parser collapses `.`/`..`/%2e%2e segments BEFORE Hono
#     sees them, hence rule 1.
#   - Upgrade dispatch: server/src/upgradeDispatch.ts routes on the UNDECODED WHATWG pathname:
#     only literal /api (or /api/...) is admitted; everything else is destroyed (no response).
#
# Custom session dashboards (design docs/design/custom-session-dashboards.md section 10.3, J6).
# The extra rules live in two snippets and ONE line, placed after rule 5 and before rule 6, imports
# the one named by ROUTER_CUSTOM_DASHBOARDS (`on` or `off`; unset or empty means `off`):
#   * `off` is EMPTY, so with the setting off (or unset) the adapted config is byte-identical to
#     docker/scripts/caddy-adapt.baseline.json (check-envs invariant 13). Do not add anything to it.
#   * `on` sends the OAuth, MCP and runtime-host paths to the api. They cannot be always present:
#     the production `api` image is API-only and answers an unmatched GET with a plain-text 404,
#     while `web:3000` answers today's GETs on those paths with Next's HTML not-found page, so an
#     always-present rule would change deployments that never opt in. With `on` the adapted config
#     matches docker/scripts/caddy-adapt.on.baseline.json (invariant 13, fixture runtime host).
#   * ROUTER_DASHBOARD_RUNTIME_HOST is read only by the `on` snippet. docker/scripts/check-envs.sh
#     requires it to be a bare host name equal to the api's DASHBOARD_RUNTIME_ORIGIN host, and
#     server/src/bootGuard.ts refuses to boot on a mismatch, so a value cannot break out of a
#     matcher or a header value. Both settings must equal the api's.

{
	auto_https off
	# Loopback-only admin: used solely by the compose healthcheck (`wget http://127.0.0.1:2019/config/`).
	# It is unreachable from either compose network. persist_config off: no autosave file, so the
	# container can run non-root with a read-only root filesystem.
	admin 127.0.0.1:2019
	persist_config off

	servers {
		# Trust forwarded headers ONLY from the pinned gateways (front + back bridge gateways in
		# compose.yaml; the host's Newt/Pangolin arrives NAT'd from the bridge gateway).
		# Strict: walk X-Forwarded-For right-to-left, stop at the first untrusted hop, so a
		# client-forged X-Forwarded-For is never adopted. `header_up X-Forwarded-For {client_ip}`
		# below then hands api exactly ONE value (TRUST_PROXY=1 on the api side).
		# The gateways come from ROUTER_FRONT_GW / ROUTER_BACK_GW, defaulting (only when UNSET;
		# an empty value is not defaulted) to prod's addresses. Only a non-prod stack's env file
		# may set them; compose.yaml must never set ROUTER_FRONT_GW/ROUTER_BACK_GW. Each value must be a single dotted
		# IPv4 address (docker/scripts/check-envs.sh enforces this).
		trusted_proxies static {$ROUTER_FRONT_GW:172.28.10.1} {$ROUTER_BACK_GW:172.28.11.1}
		trusted_proxies_strict
	}
}

# ---- Custom session dashboards: the two snippets (see the header; imported before rule 6) -------
(custom-dashboards-off) {
}

(custom-dashboards-on) {
	# The runtime host: every request for it goes to the api, which serves /runtime/v1/* there and
	# answers 404 for everything else, by checking Host before routing. Case-insensitive Host
	# match; the port is ignored by Caddy's host matcher.
	@dashboardRuntimeHost host {$ROUTER_DASHBOARD_RUNTIME_HOST}
	handle @dashboardRuntimeHost {
		reverse_proxy api:8787 {
			header_up X-Forwarded-For {client_ip}
			transport http {
				compression off
			}
		}
	}

	# Exact raw-URI paths (query allowed, nothing after the path), GET and HEAD only: look-alikes
	# (/mcpx, /mcp/x, /oauthx) and percent-encoded spellings (/%6Dcp) stay with web, as the
	# server's own routing agrees. Other methods and trailing-slash paths already reach the api
	# through rules 4 and 5.
	@dashboardPaths {
		method GET HEAD
		expression `{http.request.uri}.matches("^/(\\.well-known/oauth-(protected-resource(/mcp)?|authorization-server)|oauth/authorize(/resume)?|mcp)(\\?|$)")`
	}
	handle @dashboardPaths {
		reverse_proxy api:8787 {
			header_up X-Forwarded-For {client_ip}
			transport http {
				compression off
			}
		}
	}

	# The app's frame-src policy (design section 9.2), on every response for a host that is not the
	# runtime host. `?` sets it only when the upstream sent no Content-Security-Policy, so web's
	# documents get it and the api's own policies (the OAuth pages) are kept.
	@dashboardAppHost not host {$ROUTER_DASHBOARD_RUNTIME_HOST}
	header @dashboardAppHost ?Content-Security-Policy "frame-src https://{$ROUTER_DASHBOARD_RUNTIME_HOST}/runtime/v1/frame.html"
}

:8080 {
	header {
		-Server
		-Via
	}

	# All matchers below are CEL expressions over {http.request.uri} (raw path + ?query). In the
	# /api|/auth prefix regexp each letter may be literal or %XX (hex case-insensitive; letters
	# themselves case-sensitive) and must be followed by `/`, `?` or end -- `%2F` after the prefix
	# is NOT a `/` (decodeURI leaves it encoded), so /api%2Fx is not a prefix match.

	# ---- Rule 1: traversal-shaped raw targets -> rewrite to a fixed non-inventory path ------------
	# (a) a `.`/`..` segment in any %2e/%2E/literal mix, (b) an empty segment `//` in the path
	# part, (c) under /api or /auth: encoded `/` or `\` in any hex case. The rewrite keeps the
	# query and lands outside /api and /auth, so the server's own notFound() answers, for every
	# method, exactly as it would for any unknown non-API path.
	@traversal expression `{http.request.uri}.matches("(?i)^[^?]*/(\\.|%2e){1,2}(/|\\?|$)") || {http.request.uri}.matches("^[^?]*//") || ({http.request.uri}.matches("^/(a|%61)(p|%70)(i|%69)(/|\\?|$)|^/(a|%61)(u|%75)(t|%74)(h|%68)(/|\\?|$)") && {http.request.uri}.matches("^[^?]*(%2[fF]|%5[cC])"))`
	handle @traversal {
		rewrite * /__autologger_rejected
		reverse_proxy api:8787 {
			header_up X-Forwarded-For {client_ip}
			transport http {
				compression off
			}
		}
	}

	# ---- Rule 2: Upgrade outside literal /api -> abort (close, write nothing) ---------------------
	# Reproduces upgradeDispatch's socket destroy, for exactly what Node's http server calls an
	# upgrade: a non-empty `Upgrade` header AND a `Connection` header carrying the `upgrade` token
	# (case-insensitive, comma list; Caddy joins repeated Connection headers with ", "). An
	# `Upgrade` header without that token is an ordinary request in Node and is passed on.
	# Applies to /auth and to /%61pi/... too: the server's upgrade path uses the undecoded
	# pathname, so encoded letters are not /api there.
	@upgradeOutsideApi expression `{http.request.header.Upgrade} != "" && {http.request.header.Connection}.matches("(?i)(^|,)[ \\t]*upgrade[ \\t]*(,|$)") && !{http.request.uri}.matches("^/api(/|\\?|$)")`
	handle @upgradeOutsideApi {
		abort
	}

	# ---- Rule 3: /api, /auth (and below) -> api; WebSocket upgrades on /api proxy through ---------
	# Caddy's reverse_proxy handles the Upgrade handshake natively. Streaming: response bodies
	# with Content-Type text/event-stream are flushed immediately by Caddy (it enables an
	# immediate-flush path for SSE), so flush_interval is left at its default rather than -1.
	@apiPrefix expression `{http.request.uri}.matches("^/(a|%61)(p|%70)(i|%69)(/|\\?|$)|^/(a|%61)(u|%75)(t|%74)(h|%68)(/|\\?|$)")`
	handle @apiPrefix {
		reverse_proxy api:8787 {
			header_up X-Forwarded-For {client_ip}
			transport http {
				compression off
			}
		}
	}

	# ---- Rule 4: anything but GET/HEAD -> api (the API-only bridge answers 404 for non-API) -------
	@nonRead not method GET HEAD
	handle @nonRead {
		reverse_proxy api:8787 {
			header_up X-Forwarded-For {client_ip}
			transport http {
				compression off
			}
		}
	}

	# ---- Rule 5: raw path other than `/` ending in `/` -> api (bridge: trailing slash -> 404) ----
	# Raw `%2F` at the end is not a trailing slash (Hono keeps it encoded), so /sessions/a%2F
	# falls through to web, as in the single-process server.
	@trailing expression `{http.request.uri}.matches("^[^?]+/(\\?|$)") && !{http.request.uri}.matches("^/(\\?|$)")`
	handle @trailing {
		reverse_proxy api:8787 {
			header_up X-Forwarded-For {client_ip}
			transport http {
				compression off
			}
		}
	}

	# ---- Custom dashboards: `on` or `off` snippet (after rule 5, before rule 6) -------------------
	import custom-dashboards-{$ROUTER_CUSTOM_DASHBOARDS:off}

	# ---- Rule 6: everything else -> web ----------------------------------------------------------
	handle {
		reverse_proxy web:3000 {
			transport http {
				compression off
			}
		}
	}
}
