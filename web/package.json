{
  "name": "autologger-web",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && NEXT_TELEMETRY_DISABLED=1 next build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "diff": "8.0.4",
    "lucide-react": "^1.70.0",
    "next": "^15.5.26",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
