{
  "name": "autologger-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "sh -c 'HOST=${HOST:-127.0.0.1} NEXT_TELEMETRY_DISABLED=1 tsx watch --env-file-if-exists=.env src/main.ts'",
    "start": "NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 tsx --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:real": "RUN_REAL_AI_TESTS=1 vitest run real.test",
    "fixtures:capture": "UPDATE_API_FIXTURES=1 vitest run --project integration src/routers/apiResponseFixtures.int.test.ts",
    "merge-audio": "tsx --env-file-if-exists=.env scripts/merge-session-audio.ts",
    "capture:deepgram-fixture": "node --env-file-if-exists=.env scripts/capture-deepgram-fixture.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.216",
    "@autologger/ai-runtime": "*",
    "@autologger/catalog": "*",
    "@autologger/contract": "*",
    "@autologger/domain": "*",
    "@autologger/log-import": "*",
    "@autologger/media-import": "*",
    "@autologger/ports": "*",
    "@autologger/session-core": "*",
    "@autologger/storage": "*",
    "@autologger/transcription": "*",
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "exceljs": "^4.4.0",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "next": "^15.5.23",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
