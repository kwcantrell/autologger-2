# .env.example — copy to .env (gitignored). Node reads it via --env-file-if-exists.
# Where SQLite DBs + audio bytes live:
DATA_DIR=./data
HOST=0.0.0.0
PORT=8787

# Auth (gate decision E1: login is REQUIRED unless you explicitly set 0).
# For an open LAN-studio box: REQUIRE_LOGIN=0 (the server warns loudly on
# non-loopback binds with no IP_ALLOWLIST).
REQUIRE_LOGIN=1
PUBLIC_BASE_URL=http://127.0.0.1:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional hardening / proxy:
IP_ALLOWLIST=
TRUST_PROXY=0
COOKIE_SECURE=
SESSION_COOKIE=autologger_sid
SESSION_DAYS=14
# Deprecated (teams-self-serve): ignored by the server. New users receive
# exactly the memberships materialized from pending email invites (possibly
# none) -- never a blanket grant. Setting this to a truthy value only logs a
# one-time startup deprecation warning; it changes no behavior. Kept parsed
# (not removed) so the env shape doesn't break.
NEW_USER_ALL_TEAMS=0

# Machine tokens:
API_TOKEN=
ADMIN_TOKEN=

# Transcript generation (POST …/transcript-words/generate). Unset/blank keeps
# the endpoint's frozen 503 ("unavailable") -- unconfigured deployments are
# byte-for-byte unchanged.
#
# WARNING: setting DEEPGRAM_API_KEY sends recorded session audio to
# DeepGram's cloud API and enables BILLED, metered API calls -- every
# generate request is a paid request. Under REQUIRE_LOGIN=0 (open LAN-studio
# box), ANY client that can reach this server can trigger those calls; there
# is no additional auth gate on top of REQUIRE_LOGIN (gate decisions 3-4).
# Only set this on a box you operate and are prepared to pay for.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# AI topics chat (POST …/ai/chat). Unset/blank/whitespace CLAUDE_CLI_PATH keeps
# the endpoint's frozen 503 ("not configured") -- unconfigured deployments are
# unchanged. Set it to the `claude` CLI (absolute path or a name on PATH) to
# enable the feature; run the server as the operator who ran `claude login`.
#
# WARNING: enabling this sends session transcript + topic content to Anthropic
# via the operator's `claude` credentials, and every turn consumes the
# operator's Anthropic quota/spend. The endpoint also refuses (503) on an
# anonymous, non-loopback, no-allowlist bind so a paid endpoint is never left
# open on a LAN (see REQUIRE_LOGIN / IP_ALLOWLIST / HOST). Only set this on a
# box you operate and are prepared to pay for.
CLAUDE_CLI_PATH=
# Per-turn server-side timeout backstop, seconds (default 300).
AI_CHAT_TIMEOUT_SEC=300
# Process-wide ceiling on concurrent chat turns (small default: 2).
AI_CHAT_MAX_CONCURRENT=2
# Per-turn CLI cost ceiling in USD (default 0.5), passed as --max-budget-usd.
AI_CHAT_MAX_BUDGET_USD=0.5

# Topic generation (POST .../topics/generate) reuses the AI chat's CLI/MCP/
# gate/registry above (CLAUDE_CLI_PATH, AI_CHAT_MAX_CONCURRENT, the open-
# network refusal) as-is, but a one-shot generate reads the WHOLE transcript
# in a single turn -- delivered as multiple sequential pages at generation
# density, a much bigger workload than an incremental chat message -- so it
# gets its own spend/time bounds, defaulted HIGHER than the chat's so large
# sessions don't deterministically fail.
# Per-turn CLI cost ceiling in USD for a generate turn (default 5.0).
TOPIC_GENERATE_MAX_BUDGET_USD=5.0
# Per-turn server-side timeout backstop, seconds (default 600).
TOPIC_GENERATE_TIMEOUT_SEC=600

# Event auto-generation (POST .../events/generate) reuses the same CLI/MCP/
# gate/registry above, and its workload is likewise far past what the chat
# bounds are sized for (full transcript at generation density + a sweep per
# instruction + a create_event round-trip per hit), so it gets its own
# budget/timeout. Separately tunable from TOPIC_GENERATE_*, but defaulted to
# the SAME values -- topic generation pages the same full transcript at
# generation density, so both are sized for that read.
# Per-turn CLI cost ceiling in USD for a generate run (default 5.0).
EVENT_GENERATE_MAX_BUDGET_USD=5.0
# Per-turn server-side timeout backstop, seconds (default 600).
EVENT_GENERATE_TIMEOUT_SEC=600
# Per-run cap on events a single generate run may create (default 200).
EVENT_GENERATE_MAX_CREATED_EVENTS=200
# Aggregate pre-spawn instruction bound, checked before the CLI is spawned:
# total instruction bytes (default 24576) and instruction-bearing entry count
# (default 50) -- either tripping fails the request with 400.
EVENT_GENERATE_MAX_INSTRUCTION_BYTES=24576
EVENT_GENERATE_MAX_INSTRUCTION_ENTRIES=50

# AI v2 dashboards (POST .../ai/v2/design, .../ai/v2/answer). Independent of
# CLAUDE_CLI_PATH/AI_CHAT_* above -- enabling or disabling this feature never
# changes the AI chat's behavior, and vice versa. Off (0) by default; unlike
# CLAUDE_CLI_PATH's implicit gate, this ALSO requires the explicit flag below
# because a design turn can spend real money even with no key configured (see
# the auth note).
AI_V2_ENABLED=0
#
# WARNING: enabling this sends session AGGREGATE data (computed speaker/topic/
# event stats -- never raw transcript rows) to Anthropic via the Agent SDK,
# and every design turn is a billed request. If AI_V2_API_KEY is set, that
# workspace-scoped key pays for it. If it is NOT set, AI v2 falls back to the
# operator's interactive `claude login` session -- spending the OPERATOR'S
# PERSONAL Anthropic subscription -- and that fallback is permitted ONLY on a
# loopback bind (HOST=127.0.0.1); a non-loopback bind with no configured key
# refuses (503) to serve design turns at all, so a shared/LAN deployment can
# never silently bill the operator's personal account. The server logs
# loudly at startup whenever the login fallback is in effect. Only set
# AI_V2_ENABLED=1 on a box you operate and are prepared to pay for.
AI_V2_API_KEY=
# Per-turn spend ceiling in USD (default 0.5), the SDK's maxBudgetUsd option.
# Concurrency is NOT a separate setting here: AI v2 turns share the AI chat's
# single-flight/concurrency registry and AI_CHAT_MAX_CONCURRENT ceiling by
# design, so the two paid features bound the operator's exposure together.
AI_V2_MAX_BUDGET_USD=0.5

# YouTube audio import (POST .../sessions/:id/youtube-import). Blank by
# default. The gate is PATH-inclusive, unlike DEEPGRAM_API_KEY/
# CLAUDE_CLI_PATH above: an already-installed `yt-dlp` that's merely
# resolvable on the server process's PATH is sufficient to enable import --
# you do not have to set YTDLP_PATH on a box that already has yt-dlp on PATH.
# Set YTDLP_PATH only if you want an explicit binary (not the first `yt-dlp`
# PATH would find), e.g. a non-PATH install location.
#
# WARNING: enabling this (by either route) makes the server issue outbound
# HTTP requests to YouTube and download third-party audio to local disk for
# every import. As with DEEPGRAM_API_KEY, the endpoint refuses (503) on an
# anonymous, non-loopback, no-allowlist bind so this is never left open on a
# LAN (see REQUIRE_LOGIN / IP_ALLOWLIST / HOST). Only run this on a box you
# operate and are prepared to have make YouTube requests on your behalf.
YTDLP_PATH=

# Google Sheets log import (POST /api/shows/:showId/log-import). Off by
# default: the endpoint returns its 503 until you explicitly set
# SHEETS_LOG_IMPORT_ENABLED=1 (or true/yes). Public sheets need no API key, so
# the gate is an explicit boolean opt-in (AI_V2_ENABLED style) rather than a
# key's presence. The job-status GET (…/api/log-import/:jobId) is not gated --
# it only reads local state.
#
# WARNING: enabling this makes the server issue outbound HTTPS requests to
# docs.google.com (and no other host) to download the requested workbook
# whenever a user starts an import. An import can also trigger transcript
# generation for matched sessions that have none -- billed, metered DeepGram
# calls when DEEPGRAM_API_KEY is set. Only enable this on a box you operate
# and are prepared to have make Google requests on your behalf.
SHEETS_LOG_IMPORT_ENABLED=0
