# .env.example — the reference list of server variables. Nothing reads server/.env: the server
# runs only in a compose stack (make dev-up), which takes values from OpenBao
# (docs/openbao-secrets.md) and pins the posture keys below.
# Where SQLite DBs + audio bytes live: required, absolute (compose pins /data).
DATA_DIR=/data
# Interface to bind (compose pins it; default 127.0.0.1 outside production, 0.0.0.0 in production).
HOST=127.0.0.1
PORT=8787

# Auth: login is always required (require-login). The server refuses to boot
# when PUBLIC_BASE_URL, GOOGLE_CLIENT_ID or GOOGLE_CLIENT_SECRET is blank (all
# three are REQUIRED), or when the removed REQUIRE_LOGIN is set to any value.
PUBLIC_BASE_URL=http://127.0.0.1:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# REQUIRED (owner-bootstrap): the bootstrap owner's email. A verified sign-in with this email
# becomes owner of every team that has no owner. The server refuses to boot when it is blank or
# has a non-ASCII character.
BOOTSTRAP_OWNER_EMAIL=
# Optional (run-status-and-sweeper D9): approved users for the run features, comma-separated. The
# bootstrap owner is always approved; anyone else gets 403 on the run routes. The server refuses to
# boot when an entry has a non-ASCII character. To grant someone, add their email and restart.
RUN_FEATURE_EMAILS=
# REQUIRED (byo-ai-providers): base64 of exactly 32 bytes that encrypts users' provider API keys at
# rest. Generate one per environment with `openssl rand -base64 32`. The server refuses to boot
# without it, and refuses a different secret once keys were stored: losing it makes every stored
# provider key unreadable (users re-enter them; see docs/openbao-secrets.md).
PROVIDER_KEYS_SECRET=

# Optional hardening / proxy:
IP_ALLOWLIST=
TRUST_PROXY=0
COOKIE_SECURE=
SESSION_COOKIE=autologger_sid
SESSION_DAYS=14
# Deprecated (teams-self-serve): ignored by the server. New users receive
# exactly the memberships materialized from pending email invites (possibly
# none) -- never a blanket grant. Setting this to a truthy value only logs a
# one-time startup deprecation warning; it changes no behavior. Kept parsed
# (not removed) so the env shape doesn't break.
NEW_USER_ALL_TEAMS=0

# Machine token: ADMIN_TOKEN authenticates only /api/admin/*. API_TOKEN is ignored since ADR 0021
# slice 9d: a Companion uses a per-device token created in Settings -> Companion devices.
ADMIN_TOKEN=

# Transcript generation (POST …/transcript-words/generate) runs on each user's own speech-to-text
# key from Settings -> Advanced (byo-ai-providers). In production mode (NODE_ENV anything but
# `development` or `test`) DEEPGRAM_API_KEY is NOT used. In development mode it is the fallback for
# a user without a key.
#
# WARNING: setting DEEPGRAM_API_KEY sends recorded session audio to
# DeepGram's cloud API and enables BILLED, metered API calls -- every
# generate request is a paid request. Any signed-in member of the session's
# studio can trigger those calls; there is no additional gate beyond login.
# Only set this on a box you operate and are prepared to pay for.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# AI topics chat (POST …/ai/chat), topic generation and event generation run
# on each caller's own language model, chosen in Settings → Advanced: an
# OpenAI-compatible server, Anthropic, OpenAI or Google key (the in-process AI
# SDK route), or "Claude CLI (operator)" for the accounts on the allowlist
# below. A caller with neither gets the "Add a language model in
# Settings → Advanced" 503. CLAUDE_CLI_PATH alone enables nothing.
#
# CLAUDE_CLI_PATH: the `claude` CLI (absolute path or a name on PATH) for the
# Claude CLI route; run the server as the operator who ran `claude login`.
# WARNING: a CLI turn sends session transcript + topic content to Anthropic via
# the operator's `claude` credentials and consumes the operator's quota/spend.
CLAUDE_CLI_PATH=
# Comma-separated emails (matched trimmed, ASCII case-insensitive) that may
# choose "Claude CLI (operator)"; the bootstrap owner is NOT implicitly listed.
# Empty = nobody. Set per stack in OpenBao; never commit real addresses.
CLAUDE_CLI_EMAILS=
# AI SDK route limits (the caller's own key pays). Chat: model steps per turn
# (default 8, valid 1-50) and the per-turn token budget (default 400000); its
# output cap is fixed at 4000 tokens per step. Topic and event generation: steps
# (default 40, valid 1-100), tokens (default 3000000) and output tokens per step
# (GENERATE_MAX_OUTPUT_TOKENS, default 16000, valid 1000-128000; a model that
# answers the first request 400 is retried once at 4000). Blank, non-numeric or
# out-of-range values use the default. A turn that reaches the steps or tokens
# ends: chat answers done with the text so far, a generation run fails with its
# 502 (prior topics or events untouched). Each turn's response bytes are capped
# at steps x output tokens x 400 (12.8 MB chat, 256 MB generation by default).
AI_CHAT_MAX_STEPS=8
AI_CHAT_MAX_TOKENS=400000
GENERATE_MAX_STEPS=40
GENERATE_MAX_TOKENS=3000000
GENERATE_MAX_OUTPUT_TOKENS=16000
# Per-turn server-side timeout backstop, seconds (default 300).
AI_CHAT_TIMEOUT_SEC=300
# The AI provider (default claude_cli, the only accepted value); the server
# refuses to start with any other value.
AI_PROVIDER=claude_cli
# Per-turn CLI cost ceiling in USD (default 0.5), passed as --max-budget-usd
# (Claude CLI route only).
AI_CHAT_MAX_BUDGET_USD=0.5

# Topic generation (POST .../topics/generate) reuses the AI chat's CLI/MCP/
# gate/registry above (CLAUDE_CLI_PATH, the open-network refusal) as-is, but
# a one-shot generate reads the WHOLE transcript in a single turn -- delivered
# as multiple sequential pages at generation density, a much bigger workload
# than an incremental chat message -- so it gets its own spend/time bounds,
# defaulted HIGHER than the chat's so large sessions don't deterministically
# fail.
# Per-turn CLI cost ceiling in USD for a generate turn (default 5.0).
TOPIC_GENERATE_MAX_BUDGET_USD=5.0
# Per-turn server-side timeout backstop, seconds (default 600).
TOPIC_GENERATE_TIMEOUT_SEC=600

# Event auto-generation (POST .../events/generate) reuses the same CLI/MCP/
# gate/registry above, and its workload is likewise far past what the chat
# bounds are sized for (full transcript at generation density + a sweep per
# instruction + a create_event round-trip per hit), so it gets its own
# budget/timeout. Separately tunable from TOPIC_GENERATE_*, but defaulted to
# the SAME values -- topic generation pages the same full transcript at
# generation density, so both are sized for that read.
# Per-turn CLI cost ceiling in USD for a generate run (default 5.0).
EVENT_GENERATE_MAX_BUDGET_USD=5.0
# Per-turn server-side timeout backstop, seconds (default 600).
EVENT_GENERATE_TIMEOUT_SEC=600
# Per-run cap on events a single generate run may create (default 200).
EVENT_GENERATE_MAX_CREATED_EVENTS=200
# Aggregate pre-spawn instruction bound, checked before the CLI is spawned:
# total instruction bytes (default 24576) and instruction-bearing entry count
# (default 50) -- either tripping fails the request with 400.
EVENT_GENERATE_MAX_INSTRUCTION_BYTES=24576
EVENT_GENERATE_MAX_INSTRUCTION_ENTRIES=50

# Wiki update (POST .../wiki/generate) reuses the same gates and per-session AI
# slot, but a run reads wiki pages as well as the whole transcript and writes
# whole pages, so it has its own bounds. The timeout bounds both routes
# (default 900); the budget is the Claude CLI route's (default 5.0); the steps
# (default 80, valid 1-200) and tokens (default 6000000) are the AI SDK route's,
# whose output tokens per step come from GENERATE_MAX_OUTPUT_TOKENS. Reaching
# any of them fails the run with its 502, and nothing is stored.
WIKI_GENERATE_TIMEOUT_SEC=900
WIKI_GENERATE_MAX_BUDGET_USD=5.0
WIKI_GENERATE_MAX_STEPS=80
WIKI_GENERATE_MAX_TOKENS=6000000

# AI v2 dashboards (POST .../ai/v2/design, .../ai/v2/answer). Independent of
# CLAUDE_CLI_PATH/AI_CHAT_* above -- enabling or disabling this feature never
# changes the AI chat's behavior, and vice versa. Off (0) by default; unlike
# CLAUDE_CLI_PATH's implicit gate, this ALSO requires the explicit flag below
# because a design turn can spend real money even with no key configured (see
# the auth note).
AI_V2_ENABLED=0
#
# WARNING: enabling this sends session AGGREGATE data (computed speaker/topic/
# event stats -- never raw transcript rows) to Anthropic via the Agent SDK,
# and every design turn is a billed request. If AI_V2_API_KEY is set, that
# workspace-scoped key pays for it. If it is NOT set, AI v2 falls back to the
# operator's interactive `claude login` session -- spending the OPERATOR'S
# PERSONAL Anthropic subscription -- and that fallback is permitted ONLY on a
# loopback bind (HOST=127.0.0.1); a non-loopback bind with no configured key
# refuses (503) to serve design turns at all, so a shared/LAN deployment can
# never silently bill the operator's personal account. The server logs
# loudly at startup whenever the login fallback is in effect. Only set
# AI_V2_ENABLED=1 on a box you operate and are prepared to pay for.
AI_V2_API_KEY=
# Per-turn spend ceiling in USD (default 0.5), the SDK's maxBudgetUsd option.
# Concurrency is NOT a separate setting here: AI v2 turns share the AI chat's
# per-session single-flight registry by design.
AI_V2_MAX_BUDGET_USD=0.5

# YouTube audio import (POST .../sessions/:id/youtube-import). Blank by
# default. The gate is PATH-inclusive, unlike DEEPGRAM_API_KEY/
# CLAUDE_CLI_PATH above: an already-installed `yt-dlp` that's merely
# resolvable on the server process's PATH is sufficient to enable import --
# you do not have to set YTDLP_PATH on a box that already has yt-dlp on PATH.
# Set YTDLP_PATH only if you want an explicit binary (not the first `yt-dlp`
# PATH would find), e.g. a non-PATH install location.
#
# WARNING: enabling this (by either route) makes the server issue outbound
# HTTP requests to YouTube and download third-party audio to local disk for
# every import. Only run this on a box you operate and are prepared to have
# make YouTube requests on your behalf.
YTDLP_PATH=

# Google Sheets log import (POST /api/shows/:showId/log-import). Off by
# default: the endpoint returns its 503 until you explicitly set
# SHEETS_LOG_IMPORT_ENABLED=1 (or true/yes). Public sheets need no API key, so
# the gate is an explicit boolean opt-in (AI_V2_ENABLED style) rather than a
# key's presence. The job-status GET (…/api/log-import/:jobId) is not gated --
# it only reads local state.
#
# WARNING: enabling this makes the server issue outbound HTTPS requests to
# docs.google.com (and no other host) to download the requested workbook
# whenever a user starts an import. An import can also trigger transcript
# generation for matched sessions that have none -- billed, metered DeepGram
# calls when DEEPGRAM_API_KEY is set. Only enable this on a box you operate
# and are prepared to have make Google requests on your behalf.
SHEETS_LOG_IMPORT_ENABLED=0
